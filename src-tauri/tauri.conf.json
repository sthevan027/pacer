{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pacer",
  "version": "2.2.0-beta.2",
  "identifier": "dev.sthevan.pacer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pacer",
        "width": 300,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": "90B3F30DA2F905C7CA0EFE7485E4E026FBA74D78",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMTUwMEIwNTM4Mzk0REQKUldUZGxJTlRzQUFWV3FwOGZKS3dTa1BMMHkwT3R6RWJSTUdEUTJjbVJGVVh4NXNWKzA1ZmNZd20K",
      "endpoints": ["https://github.com/sthevan027/pacer/releases/latest/download/latest.json"]
    }
  }
}
